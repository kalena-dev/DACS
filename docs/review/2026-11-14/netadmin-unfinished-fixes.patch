+/// Run a mutating service call in its own task. A client that disconnects
+/// (the coordinator gives up after 20 s) drops the handler future; the
+/// spawned task still runs to completion, so the Headscale mutation is always
+/// followed by its audit line.
+async fn detached<T, F>(op: F) -> Result<T, Failure>
+where
+    T: Send + 'static,
+    F: Future<Output = Result<T, ServiceError>> + Send + 'static,
+{
+    match tokio::spawn(op).await {
+        Ok(result) => Ok(result?),
+        Err(e) => {
+            tracing::error!(error = %e, "operation task did not complete");
+            Err(fail(
+                StatusCode::BAD_GATEWAY,
+                "headscale_unavailable",
+                "operation did not complete",
+            ))
+        }
+    }
+}
