#!/usr/bin/env python3
"""FAKE OMP: a stand-in for the OMP executable, used only by the DACS
single-host end-to-end harness (docs/evidence/single-host-e2e/run.sh).

This is NOT OMP and NOT an agent. It never contacts a model provider, never
reads provider credentials and never opens a network connection. It speaks the
JSONL RPC framing that crates/dacs-worker/src/omp.rs and runtime.rs actually use:

  * first stdout frame `{"type":"ready","protocolVersion":1}`;
  * requests `{"type":<command>,"id":...}` answered by
    `{"type":"response","id":...,"success":true,"data":...}`;
  * host tools: it emits `host_tool_call` and waits for `host_tool_result`;
  * `agent_end`, then `prompt_result {status, sessionSettled}`.

Behaviour is deterministic and driven by `FAKE_OMP_*=value` lines in the DACS
task instructions (which the worker places in the prompt):

  FAKE_OMP_EDIT_FILE=<relative path>      file to write in the isolated workspace
  FAKE_OMP_EDIT_TEXT=<one line>           exact content (a trailing newline is added)
  FAKE_OMP_HOLD_MARKER=<absolute path>    first (non-restart) session only, and only
                                          while the marker does not exist yet: write the
                                          marker after editing and then hold, with a
                                          child process, until killed (crash drill)
  FAKE_OMP_HOLD_MAX_SECONDS=<n>           safety bound for a hold or gate (default 300)

Failure-scenario directives (docs/evidence/single-host-e2e/scenarios/):

  FAKE_OMP_WAIT_FOR=<absolute path>       after editing, write <path>.waiting and wait
                                          until <path> exists, then commit and submit
  FAKE_OMP_COMMIT_TAG_GENERATION=1        put the DACS generation in the commit subject
                                          so replacement attempts get distinct SHAs
  FAKE_OMP_COST_CAP=1                     after editing, end the turn with a cost-cap
                                          prompt_result (code cost_cap). FAKE: no
                                          provider exists and nothing was spent
  FAKE_OMP_DELEGATE_SPEC=<one-line JSON>  parent mode: call dacs_delegate once with this
                                          TaskSpec (never again once the coordinator
                                          lists a pending child or the session records
                                          it), yield, and on a durable mailbox message
                                          reporting the child `accepted` write
                                          EDIT_FILE/EDIT_TEXT, commit and submit

The worker's startup "provider-readiness turn" is answered locally with a
completed prompt_result. That is NOT provider evidence; it only lets the
control plane treat this host as agent-ready.
"""

import json
import os
import queue
import re
import subprocess
import sys
import threading
import time
import uuid

VERSION = "0.0.0-dacs-fake-omp"
COMMIT_DATE = "2026-11-14T00:00:00+0000"
TOOL_TIMEOUT = 120


def parse_args(argv):
    opts = {"tools": None, "no_tools": False, "session_dir": None, "config": None,
            "mode": None, "profile": None}
    i = 0
    while i < len(argv):
        a = argv[i]
        nxt = argv[i + 1] if i + 1 < len(argv) else None
        if a == "--no-tools":
            opts["no_tools"] = True
        elif a in ("--tools", "--session-dir", "--config", "--mode", "--profile"):
            opts[a[2:].replace("-", "_")] = nxt
            i += 1
        i += 1
    return opts


class Rpc:
    def __init__(self, trace_path):
        self.lock = threading.Lock()
        self.trace_lock = threading.Lock()
        self.trace_path = trace_path
        self.tool_results = {}
        self.tool_events = {}
        self.eof = threading.Event()
        self.prompts = queue.Queue()
        self.holding = threading.Event()
        self.closed_stdout = False
        self.directives = {}
        self.generation = None

    def trace(self, direction, payload):
        if not self.trace_path:
            return
        record = {"at": time.time(), "dir": direction, "frame": payload}
        with self.trace_lock:
            with open(self.trace_path, "a", encoding="utf-8") as f:
                f.write(json.dumps(record, sort_keys=True) + "\n")

    def log(self, message, **fields):
        fields["fake_omp"] = message
        self.trace("note", fields)
        sys.stderr.write("FAKE-OMP: " + message + "\n")
        sys.stderr.flush()

    def emit(self, frame):
        data = json.dumps(frame, separators=(",", ":"))
        with self.lock:
            if self.closed_stdout:
                return False
            try:
                sys.stdout.write(data + "\n")
                sys.stdout.flush()
            except BrokenPipeError:
                self.closed_stdout = True
                return False
        self.trace("out", frame)
        return True

    def respond(self, frame, data=None, success=True, error=None):
        out = {"type": "response", "id": frame.get("id"), "command": frame.get("type"),
               "success": success}
        if data is not None:
            out["data"] = data
        if error is not None:
            out["error"] = error
        self.emit(out)

    def call_tool(self, name, arguments):
        call_id = "fake-call-" + str(uuid.uuid4())
        tool_call_id = "fake-tool-" + str(uuid.uuid4())
        event = threading.Event()
        self.tool_events[call_id] = event
        self.emit({"type": "host_tool_call", "id": call_id, "toolCallId": tool_call_id,
                   "toolName": name, "arguments": arguments})
        deadline = time.time() + TOOL_TIMEOUT
        while not event.wait(0.2):
            if self.eof.is_set() or time.time() > deadline:
                raise RuntimeError("host tool %s got no result (eof=%s)" % (name, self.eof.is_set()))
        result = self.tool_results.pop(call_id)
        text = "".join(c.get("text", "") for c in result.get("result", {}).get("content", []))
        return bool(result.get("isError")), text


def reader(rpc, opts):
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            frame = json.loads(line)
        except ValueError:
            rpc.log("ignoring non-JSON inbound line")
            continue
        rpc.trace("in", frame)
        kind = frame.get("type")
        if kind == "host_tool_result":
            call_id = frame.get("id")
            rpc.tool_results[call_id] = frame
            event = rpc.tool_events.pop(call_id, None)
            if event:
                event.set()
        elif kind == "set_event_filter":
            rpc.respond(frame)
        elif kind == "set_host_tools":
            names = [t.get("name") for t in frame.get("tools", [])]
            rpc.log("host tools registered", tools=names)
            rpc.respond(frame)
        elif kind == "open_session":
            rpc.log("open_session for a restarted attempt; no provider transcript exists (fake)",
                    session_dir=frame.get("sessionDir"))
            rpc.respond(frame)
        elif kind == "get_session_stats":
            # Deliberately no tokens/cost: unknown usage stays unknown.
            rpc.respond(frame, data={"fake_omp": True, "provider": None,
                                     "note": "stand-in; no provider usage exists"})
        elif kind == "abort":
            rpc.log("abort requested")
            rpc.respond(frame)
        elif kind == "prompt":
            rpc.respond(frame)
            rpc.prompts.put(frame)
        else:
            rpc.respond(frame, success=False, error={"message": "fake OMP: unsupported %s" % kind})
    rpc.eof.set()
    rpc.prompts.put(None)


def directives(message):
    found = {}
    for raw in message.splitlines():
        line = raw.strip()
        if line.startswith("FAKE_OMP_") and "=" in line:
            key, value = line.split("=", 1)
            found[key[len("FAKE_OMP_"):]] = value.strip()
    return found


def git(*args, check=True):
    env = dict(os.environ)
    env.update({"GIT_AUTHOR_DATE": COMMIT_DATE, "GIT_COMMITTER_DATE": COMMIT_DATE,
                "GIT_TERMINAL_PROMPT": "0"})
    cmd = ["git", "-c", "user.name=DACS fake OMP", "-c", "user.email=fake-omp@dacs.invalid",
           "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null"] + list(args)
    out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
    if check and out.returncode != 0:
        raise RuntimeError("git %s failed: %s" % (" ".join(args), out.stderr.decode(errors="replace")))
    return out.stdout.decode(errors="replace").strip()


def write_json(path, value):
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(value, f, sort_keys=True)
    os.replace(path + ".tmp", path)


def session_file(opts, name):
    # The worker passes the same --session-dir to a resumed attempt, so these
    # files survive a worker restart exactly like an OMP session transcript.
    return os.path.join(opts["session_dir"] or os.getcwd(), name)


def generation_of(message):
    match = re.search(r"DACS managed assignment \S+ generation (\d+)", message)
    return int(match.group(1)) if match else None


def edit_and_submit(rpc, d, restart, opts, generation):
    """Write the deterministic edit, optionally hold/wait/cap, then commit and submit.
    Returns "cost_capped" when the turn already ended with a cost-cap prompt_result."""
    path = d.get("EDIT_FILE", "FAKE_OMP_PROOF.txt")
    if os.path.isabs(path) or ".." in path.split("/"):
        raise RuntimeError("edit path must stay inside the workspace")
    text = d.get("EDIT_TEXT", "edited by the DACS fake OMP stand-in") + "\n"
    head = git("rev-parse", "HEAD")
    dirty = git("status", "--porcelain")
    existing = None
    if os.path.exists(path):
        with open(path, encoding="utf-8") as f:
            existing = f.read()
    if existing == text:
        rpc.log("edit already present in the workspace (not repeated)", file=path,
                head=head, dirty=bool(dirty))
    else:
        parent = os.path.dirname(path)
        if parent:
            os.makedirs(parent, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            f.write(text)
        rpc.log("deterministic edit written", file=path)
    marker = d.get("HOLD_MARKER")
    if marker and not restart and not os.path.exists(marker):
        hold = int(d.get("HOLD_MAX_SECONDS", "300"))
        child = subprocess.Popen(["sleep", str(hold)])
        rpc.holding.set()
        write_json(marker, {"fake_omp_pid": os.getpid(), "fake_omp_pgid": os.getpgid(0),
                            "child_pid": child.pid, "workspace": os.getcwd(),
                            "uncommitted_edit": path, "generation": generation})
        rpc.log("holding with an uncommitted edit until killed (crash drill)",
                marker=marker, child_pid=child.pid, max_seconds=hold)
        child.wait()
        rpc.log("hold bound elapsed without being killed; refusing to continue")
        os._exit(3)
    gate = d.get("WAIT_FOR")
    if gate and not os.path.exists(gate):
        bound = time.time() + int(d.get("HOLD_MAX_SECONDS", "300"))
        write_json(gate + ".waiting", {"fake_omp_pid": os.getpid(), "fake_omp_pgid": os.getpgid(0),
                                       "workspace": os.getcwd(), "uncommitted_edit": path,
                                       "generation": generation})
        rpc.log("waiting for harness gate before commit/submit", gate=gate)
        while not os.path.exists(gate):
            if time.time() > bound:
                rpc.log("gate never released; refusing to continue")
                os._exit(3)
            time.sleep(0.2)
        rpc.log("harness gate released", gate=gate, stdin_closed=rpc.eof.is_set())
    if d.get("COST_CAP") == "1":
        # The frame shape follows the real-OMP adapter contract test
        # (crates/dacs-worker/tests/omp_real.rs owner_cost_cap_is_reported_distinctly).
        # No provider exists here and no money was spent: this is a FAKE cap report.
        rpc.log("reporting a FAKE cost cap (no provider, no spend); edit left uncommitted")
        rpc.emit({"type": "notice", "source": "cost-gate", "fake_omp": True,
                  "message": "FAKE stand-in cost gate (no provider spend)"})
        return "cost_capped"
    if git("status", "--porcelain"):
        git("add", "--", path)
        subject = "fake-omp: write %s" % path
        if d.get("COMMIT_TAG_GENERATION") == "1" and generation is not None:
            subject += " (generation %d)" % generation
        git("commit", "-q", "-m", subject)
        rpc.log("committed", head=git("rev-parse", "HEAD"))
    sha = git("rev-parse", "HEAD")
    shown = subprocess.run(["git", "show", "HEAD:" + path], stdout=subprocess.PIPE,
                           stderr=subprocess.PIPE)
    passed = shown.returncode == 0 and shown.stdout.decode() == text
    evidence = [{"name": "fake-omp content check",
                 "command": "git show HEAD:%s == FAKE_OMP_EDIT_TEXT" % path,
                 "source_sha": sha, "passed": passed, "artifact_digest": None}]
    submit_err, submitted = rpc.call_tool("dacs_submit", {"evidence": evidence,
                                                          "unresolved": []})
    rpc.log("dacs_submit answered", is_error=submit_err, result=submitted[:2000],
            candidate_sha=sha, check_passed=passed)
    return "submitted"


def delegate_once(rpc, d, pending, opts):
    """Parent mode: delegate the child TaskSpec once, then yield and wait for mail."""
    record = session_file(opts, "fake-omp-delegation.json")
    children = pending.get("pending_children") or []
    if os.path.exists(record) or children:
        rpc.log("delegation already durable; not repeated; waiting for the mailbox",
                pending_children=children, local_record=os.path.exists(record))
        return
    spec = json.loads(d["DELEGATE_SPEC"])
    is_error, result = rpc.call_tool("dacs_delegate", {"spec": spec})
    write_json(record, {"is_error": is_error, "result": result[:4000]})
    rpc.log("dacs_delegate answered", is_error=is_error, result=result[:2000])
    rpc.log("yielding the turn; parent obligation now waits for child_result mail")


def end_turn(rpc, prompt_id, outcome):
    rpc.emit({"type": "agent_end"})
    if outcome == "cost_capped":
        rpc.emit({"type": "prompt_result", "id": prompt_id, "status": "error",
                  "error": {"code": "cost_cap", "retryable": False,
                            "message": "Cost cap reached (FAKE OMP stand-in: no provider, no spend)"},
                  "sessionSettled": True})
    else:
        rpc.emit({"type": "prompt_result", "id": prompt_id, "status": "completed",
                  "sessionSettled": True})


def agent_turn(rpc, frame, opts):
    message = frame.get("message", "")
    prompt_id = frame.get("id")
    restart = "This is a restart." in message
    d = directives(message)
    rpc.directives = d
    rpc.generation = generation_of(message)
    rpc.log("assignment prompt received", restart=restart, directives=sorted(d.keys()),
            cwd=os.getcwd(), generation=rpc.generation)
    outcome = None
    try:
        pending_err, pending_text = rpc.call_tool("dacs_pending", {})
        rpc.log("dacs_pending answered", is_error=pending_err, result=pending_text[:2000])
        if d.get("DELEGATE_SPEC"):
            pending = {}
            if not pending_err:
                try:
                    pending = json.loads(pending_text)
                except ValueError:
                    pending = {}
            delegate_once(rpc, d, pending, opts)
        else:
            outcome = edit_and_submit(rpc, d, restart, opts, rpc.generation)
    except Exception as exc:  # a completed turn without submission; DACS must not accept it
        rpc.log("agent turn failed: %s" % exc)
    end_turn(rpc, prompt_id, outcome)


def mailbox_turn(rpc, frame, opts):
    """Parent mode: a child_result in the durable mailbox wakes the parent."""
    message = frame.get("message", "")
    prompt_id = frame.get("id")
    payload = {}
    if "): " in message:
        try:
            payload = json.loads(message.split("): ", 1)[1])
        except ValueError:
            payload = {}
    rpc.log("durable mailbox message received", payload=payload, message=message[:2000])
    outcome = None
    try:
        done = session_file(opts, "fake-omp-parent-submitted.json")
        if payload.get("state") != "accepted":
            rpc.log("child did not finish accepted; parent does not submit")
        elif os.path.exists(done):
            rpc.log("parent already submitted after this child result (replayed mail); not repeated")
        else:
            pending_err, pending_text = rpc.call_tool("dacs_pending", {})
            rpc.log("dacs_pending answered", is_error=pending_err, result=pending_text[:2000])
            parent = dict(rpc.directives)
            parent.pop("WAIT_FOR", None)
            outcome = edit_and_submit(rpc, parent, False, opts, rpc.generation)
            write_json(done, {"child": payload.get("task_id"), "outcome": outcome})
    except Exception as exc:
        rpc.log("mailbox turn failed: %s" % exc)
    end_turn(rpc, prompt_id, outcome)


def main():
    argv = sys.argv[1:]
    if "--version" in argv:
        print("omp/%s (DACS single-host e2e stand-in; not OMP; never contacts a provider)" % VERSION)
        return 0
    opts = parse_args(argv)
    if opts["mode"] != "rpc":
        sys.stderr.write("fake OMP only implements --mode rpc\n")
        return 2
    trace = None
    if opts["session_dir"]:
        os.makedirs(opts["session_dir"], exist_ok=True)
        trace = os.path.join(opts["session_dir"], "fake-omp-trace.jsonl")
    rpc = Rpc(trace)
    overlay = None
    if opts["config"] and os.path.isfile(opts["config"]):
        with open(opts["config"], encoding="utf-8") as f:
            overlay = f.read()
    rpc.log("started", argv=argv, pid=os.getpid(), managed_overlay=overlay)
    rpc.emit({"type": "ready", "protocolVersion": 1, "fake_omp": VERSION})
    threading.Thread(target=reader, args=(rpc, opts), daemon=True).start()
    while True:
        frame = rpc.prompts.get()
        if frame is None:
            break
        message = frame.get("message", "")
        turn = None
        if frame.get("streamingBehavior") == "followUp":
            if message.startswith("Durable DACS mailbox message") and rpc.directives.get("DELEGATE_SPEC"):
                turn = mailbox_turn
            else:
                rpc.log("follow-up prompt received; nothing further to do", message=message[:2000])
                rpc.emit({"type": "prompt_result", "id": frame.get("id"), "status": "completed",
                          "sessionSettled": True})
        elif opts["no_tools"] or message.startswith("Provider readiness check only"):
            rpc.log("provider-readiness prompt answered LOCALLY; NOT provider evidence")
            rpc.emit({"type": "prompt_result", "id": frame.get("id"), "status": "completed",
                      "sessionSettled": True})
        else:
            turn = agent_turn
        if turn:
            worker = threading.Thread(target=turn, args=(rpc, frame, opts))
            worker.start()
            # Keep serving later prompts only after this turn; mirrors one active turn.
            while worker.is_alive():
                worker.join(0.2)
    rpc.log("stdin closed; exiting")
    return 0


if __name__ == "__main__":
    sys.exit(main())
